<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuantHub.Desktop.Views.Pages.SettingsView"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Button.modeCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </UserControl.Styles>

  <StackPanel MaxWidth="640" HorizontalAlignment="Left">

    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="APPEARANCE" Classes="cardTitle"/>
        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding ThemeOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Padding="18,8" Margin="2,0" MinWidth="90"
                        FontSize="13" FontWeight="SemiBold" BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding DataContext.SelectThemeCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <Button.Background>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                      <Binding Path="Theme"/>
                      <Binding Path="DataContext.Theme" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Background>
                  <Button.Foreground>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="White|TextBrush">
                      <Binding Path="Theme"/>
                      <Binding Path="DataContext.Theme" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Foreground>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="DIFFICULTY MODE" Classes="cardTitle"/>
        <ItemsControl ItemsSource="{Binding ViewModeOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="modeCard" Cursor="Hand"
                      Command="{Binding DataContext.SelectViewModeCommand, ElementName=Root}"
                      CommandParameter="{Binding}">
                <Button.Background>
                  <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                    <Binding Path="Mode"/>
                    <Binding Path="DataContext.ViewMode" ElementName="Root"/>
                  </MultiBinding>
                </Button.Background>
                <StackPanel HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14"
                             Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="AI RESEARCH" Classes="cardTitle"/>
        <TextBlock Text="Your Claude API key, used by the AI Research chat page. Stored locally only."
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>
        <TextBox Text="{Binding ClaudeApiKey}"
                 FontFamily="{StaticResource MonoFontFamily}" Width="420" HorizontalAlignment="Left"
                 ToolTip.Tip="sk-ant-..."/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
