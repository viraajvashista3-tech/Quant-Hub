<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuantHub.Desktop.SmokeTestWindow"
        Title="Quant Terminal (Avalonia Phase 1 smoke test)"
        Width="600" Height="300"
        Background="#0A0B10">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Avalonia + FluentAvalonia toolchain OK" Foreground="#00BFFF" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="Emoji glyph fallback check:" Foreground="#E6E8EC" />
    <TextBlock Text="📈 🔍 ⟳ ⚙ ✅ ❌ ⚠️ 🤖" FontSize="28" Foreground="#E6E8EC" />
    <Button Content="Sample FluentAvalonia Button" HorizontalAlignment="Left" />
  </StackPanel>
</Window>
