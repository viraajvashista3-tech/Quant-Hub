<UserControl x:Class="QuantHub.Desktop.Views.Pages.AnalystView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveBrush}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Visibility="{Binding Data, Converter={StaticResource NotEmptyToVis}}">

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Data.Ticker}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Analyst Consensus" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding ConsensusBrush}" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Data.ConsensusRating}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding Data.NumAnalysts, StringFormat='{}{0} analysts'}" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Beginner: plain-English coverage + target framing, no raw dollar grid -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsBeginner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding BeginnerSummary}" TextWrapping="Wrap" FontSize="15"/>
            </Border>

            <!-- Intermediate + Pro: raw price target figures -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="PRICE TARGETS" Style="{StaticResource CardTitleStyle}"/>
                    <UniformGrid Columns="4" Rows="1">
                        <StackPanel>
                            <TextBlock Text="Low" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding Data.TargetLow, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="20"
                                       Foreground="{DynamicResource DestructiveBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Mean" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding Data.TargetMean, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="20"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="High" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding Data.TargetHigh, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="20"
                                       Foreground="{DynamicResource PositiveBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Current" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{Binding Data.CurrentPrice, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="20"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Intermediate + Pro: recommendation trend chart -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding Data.RecommendationTrend, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="RECOMMENDATION TREND" Style="{StaticResource CardTitleStyle}"/>
                    <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" YAxes="{Binding TrendYAxes}"
                                         Background="Transparent" Height="220"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" Margin="0,0,6,0" Background="#10B981"/>
                            <TextBlock Text="Strong Buy" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" Margin="0,0,6,0" Background="#22C55E"/>
                            <TextBlock Text="Buy" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" Margin="0,0,6,0" Background="#F59E0B"/>
                            <TextBlock Text="Hold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Border Width="10" Height="10" Margin="0,0,6,0" Background="#F97316"/>
                            <TextBlock Text="Sell" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" Margin="0,0,6,0" Background="#EF4444"/>
                            <TextBlock Text="Strong Sell" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- All tiers: real recorded upgrades/downgrades read as plain sentences (Yahoo has no
                 free-text analyst quotes - this is the genuine action/grade/date history). Beginner
                 gets 5, Intermediate 15, Pro 40 (via NarrativeActions in the view model). -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding NarrativeActions, Converter={StaticResource NotEmptyToVis}}">
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
                                <Setter Property="Text" Value="WHAT WALL STREET IS SAYING"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBeginner}" Value="True">
                                        <Setter Property="Text" Value="What analysts are saying"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding NarrativeActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="6" Height="6" Margin="2,7,10,0" VerticalAlignment="Top" Fill="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
