<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuantHub.Desktop.Views.Pages.SettingsView"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Button.modeCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="Button.settingChoice">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TextBlock.settingLabel">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </UserControl.Styles>

  <StackPanel MaxWidth="640" HorizontalAlignment="Left">

    <!-- ===== Appearance: theme + accent, grouped since both are purely visual ===== -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="APPEARANCE" Classes="cardTitle"/>
        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding ThemeOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Padding="18,8" Margin="2,0" MinWidth="90"
                        FontSize="13" FontWeight="SemiBold" BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding DataContext.SelectThemeCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <Button.Background>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                      <Binding Path="Theme"/>
                      <Binding Path="DataContext.Theme" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Background>
                  <Button.Foreground>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="White|TextBrush">
                      <Binding Path="Theme"/>
                      <Binding Path="DataContext.Theme" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Foreground>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <ItemsControl ItemsSource="{Binding AccentColors}" Margin="0,14,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Padding="0" Margin="0,0,12,0" Width="36" Height="36" CornerRadius="18"
                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                      ToolTip.Tip="{Binding Label}"
                      Command="{Binding DataContext.SelectAccentCommand, ElementName=Root}"
                      CommandParameter="{Binding}">
                <Border Width="30" Height="30" CornerRadius="15" BorderThickness="3"
                        Background="{Binding Hsl, Converter={StaticResource HslToBrush}}">
                  <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="TextBrush|Transparent">
                      <Binding Path="Name"/>
                      <Binding Path="DataContext.AccentName" ElementName="Root"/>
                    </MultiBinding>
                  </Border.BorderBrush>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Difficulty mode - kept as its own card; unlike the settings below, each option's
         description is genuinely necessary reading, not filler. ===== -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="DIFFICULTY MODE" Classes="cardTitle"/>
        <ItemsControl ItemsSource="{Binding ViewModeOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="modeCard" Cursor="Hand"
                      Command="{Binding DataContext.SelectViewModeCommand, ElementName=Root}"
                      CommandParameter="{Binding}">
                <Button.Background>
                  <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                    <Binding Path="Mode"/>
                    <Binding Path="DataContext.ViewMode" ElementName="Root"/>
                  </MultiBinding>
                </Button.Background>
                <StackPanel HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14"
                             Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Behavior - Startup Page / Auto-Refresh / Always on Top, grouped into compact rows
         instead of three separate cards. Explanations moved to tooltips (hover the label) rather
         than always-visible paragraphs - the labels plus a hover for anyone curious is enough. ===== -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="BEHAVIOR" Classes="cardTitle"/>

        <Grid ColumnDefinitions="110,*" Margin="0,0,0,14">
          <TextBlock Grid.Column="0" Classes="settingLabel" Text="Start on"
                     ToolTip.Tip="Which page opens when the app launches."/>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding StartupPageOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="settingChoice" Content="{Binding Label}"
                        Command="{Binding DataContext.SelectStartupPageCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <Button.Background>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                      <Binding Path="Page"/>
                      <Binding Path="DataContext.StartupPage" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Background>
                  <Button.Foreground>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="White|TextBrush">
                      <Binding Path="Page"/>
                      <Binding Path="DataContext.StartupPage" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Foreground>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Grid ColumnDefinitions="110,*" Margin="0,0,0,14">
          <TextBlock Grid.Column="0" Classes="settingLabel" Text="Auto-refresh"
                     ToolTip.Tip="Silently re-fetch whatever page is open on this interval - handy on a second monitor."/>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding AutoRefreshOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="settingChoice" Content="{Binding Label}"
                        Command="{Binding DataContext.SelectAutoRefreshCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <Button.Background>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                      <Binding Path="Interval"/>
                      <Binding Path="DataContext.AutoRefreshInterval" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Background>
                  <Button.Foreground>
                    <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="White|TextBrush">
                      <Binding Path="Interval"/>
                      <Binding Path="DataContext.AutoRefreshInterval" ElementName="Root"/>
                    </MultiBinding>
                  </Button.Foreground>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}"
                  ToolTip.Tip="Keep this window above other apps - handy for a second monitor you check at a glance."/>
      </StackPanel>
    </Border>

    <!-- ===== Data - watchlist backup, kept minimal ===== -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="WATCHLIST BACKUP" Classes="cardTitle" ToolTip.Tip="Your watchlist lives only on this machine. Import merges into whatever's already here - it never replaces it."/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ExportWatchlistButton" Content="⬇ Export Watchlist" Margin="0,0,8,0"/>
          <Button x:Name="ImportWatchlistButton" Content="⬆ Import Watchlist"/>
        </StackPanel>
        <TextBlock x:Name="BackupStatusText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" IsVisible="False"/>
      </StackPanel>
    </Border>

    <!-- ===== About ===== -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="ABOUT" Classes="cardTitle"/>
        <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,10"
                   Text="A transparent, honestly-backtested stock research terminal. For research only - not investment advice."/>
        <Button Content="⭐ View on GitHub" HorizontalAlignment="Left" Cursor="Hand"
                Command="{Binding OpenRepositoryCommand}"/>

        <Border IsVisible="{Binding UpdateAvailable}" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="10"
                Padding="14,12" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⬆" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
            <StackPanel>
              <TextBlock Text="{Binding UpdateVersionText}" FontWeight="Bold" FontSize="13"
                         Foreground="{DynamicResource TextBrush}"/>
              <Button Content="Download" Padding="10,4" Margin="0,6,0,0" Cursor="Hand"
                      Command="{Binding OpenUpdatePageCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
