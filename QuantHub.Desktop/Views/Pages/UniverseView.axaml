<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:QuantHub.Desktop.Views.Controls"
             x:Class="QuantHub.Desktop.Views.Pages.UniverseView"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Border.stockCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,16,16"/>
      <Setter Property="Width" Value="300"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Styles>

  <Panel>
  <StackPanel>

    <!-- ===== Similar stocks ===== -->

    <controls:ErrorCard Message="{Binding ErrorMessage}"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Similar to " FontSize="15" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom"/>
      <TextBlock Text="{Binding ActiveTicker}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource UniverseAccentBrush}" VerticalAlignment="Bottom"/>
    </StackPanel>

    <TextBlock Text="{Binding SectorMoodSummary}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
               IsVisible="{Binding SectorMoodSummary, Converter={StaticResource NotEmptyToVis}}" Margin="0,0,0,20"/>

    <ItemsControl ItemsSource="{Binding SimilarStocks}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="stockCard" BorderThickness="4,1,1,1"
                  BorderBrush="{Binding ChangePercent, Converter={StaticResource SignToBrush}}">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="link"
                        Command="{Binding DataContext.SelectTickerCommand, ElementName=Root}"
                        CommandParameter="{Binding Ticker}" ToolTip.Tip="Open in Terminal">
                  <StackPanel>
                    <TextBlock Text="{Binding Ticker}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource UniverseAccentBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <Border Background="{DynamicResource PanelBorderBrush}" CornerRadius="10"
                          Padding="8,3" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Sector}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                  </Border>
                  <Button Content="+" Padding="7,2" FontWeight="Bold"
                          Command="{Binding DataContext.AddTickerCommand, ElementName=Root}" CommandParameter="{Binding Ticker}"
                          ToolTip.Tip="Add to watchlist"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{Binding Price, StringFormat={}{0:0.00}}" FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding ChangePercent, StringFormat=' {0:+0.00;-0.00}%'}" FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding ChangePercent, Converter={StaticResource SignToBrush}}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== Watchlist ===== -->

    <controls:ErrorCard Message="{Binding WatchlistErrorMessage}" Margin="0,28,0,0"/>

    <Border Classes="card" Margin="0,28,0,16">
      <StackPanel>
        <TextBlock Text="{Binding WatchlistSectionTitle}" Classes="cardTitle"/>
        <Grid ColumnDefinitions="*,Auto">
          <AutoCompleteBox x:Name="AddBox" Grid.Column="0" Text="{Binding AddTickerInput}"
                            FilterMode="None" MinimumPrefixLength="1" ValueMemberBinding="{Binding Symbol}"
                            Watermark="Type a ticker or company name...">
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="4">
                  <TextBlock Text="{Binding Symbol}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}"/>
                  <TextBlock Text="{Binding Name, StringFormat=' — {0}'}" Foreground="{DynamicResource MutedTextBrush}"
                             Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>
          <Button Grid.Column="1" Content="+ Add" Classes="primary" Margin="8,0,0,0"
                  Command="{Binding AddTickerCommand}" CommandParameter="{Binding AddTickerInput}"/>
        </Grid>
        <TextBlock Text="{Binding WatchlistSummary}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                   IsVisible="{Binding WatchlistSummary, Converter={StaticResource NotEmptyToVis}}" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>

    <TextBlock Text="Your watchlist is empty, so here are some popular stocks instead - add your own above, or use the + on a similar-stock card, to start tracking price and Quant Score here."
               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
               IsVisible="{Binding IsShowingSuggestedTickers}"/>

    <Border Classes="card" IsVisible="{Binding HasWatchlistRows}">
      <StackPanel>
        <!-- Rank-by pills - "best to buy first" reorders the table below by whichever metric is
             selected; RankingMetricOptions/SelectWatchlistRankMetricCommand are shared with the
             Universe Top 20 table's own pill row further down. -->
        <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="RANKED BY" Classes="sectionLabel" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="3">
            <ItemsControl ItemsSource="{Binding RankingMetricOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Label}" Padding="10,5" Margin="2,0" FontSize="11" FontWeight="SemiBold" BorderThickness="0"
                          Command="{Binding DataContext.SelectWatchlistRankMetricCommand, ElementName=Root}"
                          CommandParameter="{Binding}">
                    <Button.Background>
                      <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                        <Binding Path="."/>
                        <Binding Path="DataContext.WatchlistRankMetric" ElementName="Root"/>
                      </MultiBinding>
                    </Button.Background>
                    <Button.Foreground>
                      <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="White|TextBrush">
                        <Binding Path="."/>
                        <Binding Path="DataContext.WatchlistRankMetric" ElementName="Root"/>
                      </MultiBinding>
                    </Button.Foreground>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Button Grid.Column="2" x:Name="ExportWatchlistButton" Content="⬇ CSV" Padding="10,5" Margin="8,0,0,0"
                  FontSize="11" ToolTip.Tip="Export the watchlist table as a CSV file"/>
        </Grid>

        <Grid Margin="0,0,0,10" ColumnDefinitions="36,90,*,90,90,70,80,90,90,50">
          <TextBlock Grid.Column="1" Text="TICKER" Classes="sectionLabel"/>
          <TextBlock Grid.Column="2" Text="NAME" Classes="sectionLabel"/>
          <TextBlock Grid.Column="3" Text="PRICE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="4" Text="CHANGE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="5" Text="SCORE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="6" Text="UPSIDE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="7" Text="RATING" Classes="sectionLabel"/>
          <TextBlock Grid.Column="8" Text="SIGNAL" Classes="sectionLabel"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding WatchlistRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10" ColumnDefinitions="36,90,*,90,90,70,80,90,90,50">
                <Border Grid.Column="0" Classes="rankBadge">
                  <TextBlock Text="{Binding Rank}" Classes="rankBadgeText"/>
                </Border>
                <Button Grid.Column="1" Classes="link"
                        Command="{Binding DataContext.SelectTickerCommand, ElementName=Root}" CommandParameter="{Binding Ticker}">
                  <TextBlock Text="{Binding Ticker}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold"
                             Foreground="{DynamicResource PrimaryBrush}"/>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat={}{0:0.00}}" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding ChangePercent, StringFormat={}{0:+0.00;-0.00}%}" FontFamily="{StaticResource MonoFontFamily}"
                           VerticalAlignment="Center" Foreground="{Binding ChangePercent, Converter={StaticResource SignToBrush}}"/>
                <TextBlock Grid.Column="5" Text="{Binding QuantScore, StringFormat={}{0:0.0}}" FontFamily="{StaticResource MonoFontFamily}"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding UpsidePotentialPct, StringFormat={}{0:+0.0;-0.0}%}" FontFamily="{StaticResource MonoFontFamily}"
                           VerticalAlignment="Center" Foreground="{Binding UpsidePotentialPct, Converter={StaticResource SignToBrush}}"/>
                <TextBlock Grid.Column="7" Text="{Binding ConsensusRating}" FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding ConsensusRating, Converter={StaticResource ConsensusRatingToBrush}}"/>
                <Border Grid.Column="8" Classes="statusBadge" Background="{Binding Signal, Converter={StaticResource SignalToBrush}}"
                        Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Signal}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                </Border>
                <Button Grid.Column="9" Content="✕" Padding="6,2" VerticalAlignment="Center"
                        Command="{Binding DataContext.RemoveTickerCommand, ElementName=Root}" CommandParameter="{Binding Ticker}"
                        ToolTip.Tip="Remove from watchlist"
                        IsVisible="{Binding DataContext.IsShowingSuggestedTickers, ElementName=Root, Converter={StaticResource InverseBoolToVis}}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Universe Top 20 ===== -->
    <!-- Ranks the full 128-ticker universe (not just the watchlist) three interchangeable ways,
         read from UniverseRankingService's cached sweep (never a live fetch on page load) - see
         UniverseViewModel.RebuildTop20. -->

    <Border Classes="card" Margin="0,28,0,16">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Grid.Column="0">
            <TextBlock Text="UNIVERSE TOP 20" Classes="cardTitle" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Top20LastUpdatedText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                         IsVisible="{Binding Top20LastUpdatedText, Converter={StaticResource NotEmptyToVis}}"/>
              <TextBlock Text="Sweeping the universe…" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                         IsVisible="{Binding IsUniverseSweeping}"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="3" VerticalAlignment="Top">
            <ItemsControl ItemsSource="{Binding RankingMetricOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Label}" Padding="10,5" Margin="2,0" FontSize="11" FontWeight="SemiBold" BorderThickness="0"
                          Command="{Binding DataContext.SelectRankingMetricCommand, ElementName=Root}"
                          CommandParameter="{Binding}">
                    <Button.Background>
                      <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="PrimaryBrush|SurfaceBrush">
                        <Binding Path="."/>
                        <Binding Path="DataContext.SelectedRankingMetric" ElementName="Root"/>
                      </MultiBinding>
                    </Button.Background>
                    <Button.Foreground>
                      <MultiBinding Converter="{StaticResource EqualsToBrush}" ConverterParameter="White|TextBrush">
                        <Binding Path="."/>
                        <Binding Path="DataContext.SelectedRankingMetric" ElementName="Root"/>
                      </MultiBinding>
                    </Button.Foreground>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Button Grid.Column="2" x:Name="ExportTop20Button" Content="⬇ CSV" Padding="10,5" Margin="8,0,0,0"
                  FontSize="11" VerticalAlignment="Top" ToolTip.Tip="Export the Top 20 table as a CSV file"/>
        </Grid>

        <Grid Margin="0,20,0,10" ColumnDefinitions="36,90,*,90,70,80,90,90">
          <TextBlock Grid.Column="1" Text="TICKER" Classes="sectionLabel"/>
          <TextBlock Grid.Column="2" Text="NAME" Classes="sectionLabel"/>
          <TextBlock Grid.Column="3" Text="PRICE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="4" Text="SCORE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="5" Text="UPSIDE" Classes="sectionLabel"/>
          <TextBlock Grid.Column="6" Text="RATING" Classes="sectionLabel"/>
          <TextBlock Grid.Column="7" Text="SIGNAL" Classes="sectionLabel"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Top20Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10" ColumnDefinitions="36,90,*,90,70,80,90,90">
                <Border Grid.Column="0" Classes="rankBadge">
                  <TextBlock Text="{Binding Rank}" Classes="rankBadgeText"/>
                </Border>
                <Button Grid.Column="1" Classes="link"
                        Command="{Binding DataContext.SelectTickerCommand, ElementName=Root}" CommandParameter="{Binding Ticker}">
                  <TextBlock Text="{Binding Ticker}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold"
                             Foreground="{DynamicResource UniverseAccentBrush}"/>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat={}{0:0.00}}" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding QuantScore, StringFormat={}{0:0.0}}" FontFamily="{StaticResource MonoFontFamily}"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding UpsidePotentialPct, StringFormat={}{0:+0.0;-0.0}%}" FontFamily="{StaticResource MonoFontFamily}"
                           VerticalAlignment="Center" Foreground="{Binding UpsidePotentialPct, Converter={StaticResource SignToBrush}}"/>
                <TextBlock Grid.Column="6" Text="{Binding ConsensusRating}" FontWeight="SemiBold" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding ConsensusRating, Converter={StaticResource ConsensusRatingToBrush}}"/>
                <Border Grid.Column="7" Classes="statusBadge" Background="{Binding Signal, Converter={StaticResource SignalToBrush}}"
                        Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Signal}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel HorizontalAlignment="Center" Margin="0,28" MaxWidth="360"
                    IsVisible="{Binding HasTop20Rows, Converter={StaticResource InverseBoolToVis}}">
          <TextBlock Text="🧭" FontSize="30" HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,10"/>
          <TextBlock Text="Sweeping the universe for the first time" FontWeight="Bold" FontSize="13"
                     HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>
          <TextBlock Text="This ranks all 138 tickers by Quant Score, Upside Potential, and Analyst Rating - it happens automatically shortly after launch, or you can trigger it now with Refresh."
                     Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Month-over-month change explanations - deterministic, template-built from the same
             component-score/target-price/consensus-rating deltas the rest of the app already
             explains reasoning with (see UniverseRanking.ExplainTopNChanges). -->
        <StackPanel Margin="0,20,0,0" IsVisible="{Binding HasTop20ChangeExplanations}">
          <TextBlock Text="WHAT CHANGED THIS MONTH" Classes="cardTitle"/>
          <ItemsControl ItemsSource="{Binding Top20ChangeExplanations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="•" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource UniverseAccentBrush}"/>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="Monthly comparison will be available after this ranking has run in a second calendar month."
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,20,0,0"
                   IsVisible="{Binding HasTop20ChangeExplanations, Converter={StaticResource InverseBoolToVis}}"/>
      </StackPanel>
    </Border>
  </StackPanel>
  <controls:BusyOverlay IsBusy="{Binding IsBusy}"/>
  </Panel>
</UserControl>
