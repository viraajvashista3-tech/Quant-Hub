<UserControl x:Class="QuantHub.Desktop.Views.Pages.PeersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveBrush}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Visibility="{Binding Data, Converter={StaticResource NotEmptyToVis}}">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{Binding Data.Ticker}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="{Binding Data.Sector}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Bottom" Margin="12,0,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding Rows, Converter={StaticResource NotEmptyToVis}}">
                <StackPanel>
                    <TextBlock Text="P/E COMPARISON" Style="{StaticResource CardTitleStyle}"/>
                    <lvc:CartesianChart Series="{Binding ComparisonSeries}" XAxes="{Binding ComparisonXAxes}" YAxes="{Binding ComparisonYAxes}"
                                         Background="Transparent" Height="220"/>
                </StackPanel>
            </Border>

            <!-- Beginner: three-column table, no jargon-heavy metrics -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsBeginner, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="How it stacks up" Style="{StaticResource FriendlyCardTitleStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="COMPANY" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="PRICE" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="2" Text="P/E RATIO" Style="{StaticResource SectionLabelStyle}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" Margin="0,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSubject}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Stock.Ticker}" FontFamily="Consolas" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Stock.Name}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Stock.Price, StringFormat={}{0:0.00}}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Stock.Pe, StringFormat={}{0:0.0}x}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Intermediate + Pro: full metrics table -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="PEER COMPARISON" Style="{StaticResource CardTitleStyle}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,10" MinWidth="920">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TICKER" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="PRICE" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="P/E" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="FWD P/E" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="4" Text="DIV YIELD" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="5" Text="BETA" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="6" Text="MARKET CAP" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="7" Text="MARGIN" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="8" Text="D/E" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Grid.Column="9" Text="ROE" Style="{StaticResource SectionLabelStyle}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinWidth="920" Padding="0,8" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSubject}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Stock.Ticker}" FontFamily="Consolas" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Stock.Name}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Stock.Price, StringFormat={}{0:0.00}}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Stock.Pe, StringFormat={}{0:0.0}}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Stock.ForwardPe, StringFormat={}{0:0.0}}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Stock.DividendYield, StringFormat=P2}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Stock.Beta, StringFormat={}{0:0.00}}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Stock.MarketCap, StringFormat=N0}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{Binding Stock.ProfitMargins, StringFormat=P1}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="{Binding Stock.DebtToEquity, StringFormat={}{0:0.0}}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="9" Text="{Binding Stock.ReturnOnEquity, StringFormat=P1}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Pro only: return correlation heatmap -->
            <Border Style="{StaticResource ProCardStyle}" Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="RETURN CORRELATION" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Pearson correlation of daily returns over the trailing year - closer to 1 means the stocks tend to move together, closer to -1 means they move opposite each other."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding CorrelationRows, Converter={StaticResource NotEmptyToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="60" Height="30"/>
                                <ItemsControl ItemsSource="{Binding CorrelationHeaderTickers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="64" Height="30" Margin="1,0">
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CorrelationRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Border Width="60" Height="36">
                                                <TextBlock Text="{Binding Ticker}" FontFamily="Consolas" FontWeight="Bold" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="64" Height="36" Margin="1,0" Background="{Binding Background}">
                                                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding Data.Summary, Converter={StaticResource NotEmptyToVis}}">
                <StackPanel>
                    <TextBlock Text="BOTTOM LINE" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding Data.Summary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
