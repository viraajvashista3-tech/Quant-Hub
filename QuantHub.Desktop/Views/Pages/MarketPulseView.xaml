<UserControl x:Class="QuantHub.Desktop.Views.Pages.MarketPulseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveBrush}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Visibility="{Binding Data, Converter={StaticResource NotEmptyToVis}}">

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MARKET MOOD" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding Data.MarketMood}" FontSize="26" FontWeight="Bold" Foreground="{Binding MoodBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="VIX" Style="{StaticResource SectionLabelStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Data.Vix, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="22" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Beginner: plain-English mood + rotation read; Intermediate/Pro see the raw note instead -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsBeginner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding BeginnerSummary}" TextWrapping="Wrap" FontSize="15"/>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding Data.RotationNote, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="{Binding Data.RotationNote}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="MAJOR INDICES" Style="{StaticResource CardTitleStyle}"/>
                    <ItemsControl ItemsSource="{Binding Data.Indices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="18"/>
                                    <TextBlock Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" FontFamily="Consolas" FontSize="13"
                                               Foreground="{Binding ChangePct, Converter={StaticResource SignToBrush}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding Data.Sectors, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="SECTOR PERFORMANCE (1D %)" Style="{StaticResource CardTitleStyle}"/>
                    <lvc:CartesianChart Series="{Binding SectorSeries}" XAxes="{Binding SectorXAxes}" YAxes="{Binding SectorYAxes}"
                                         Background="Transparent" Height="380"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="MACRO" Style="{StaticResource CardTitleStyle}"/>
                    <ItemsControl ItemsSource="{Binding Data.Macro}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,16">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:0.00}}" FontFamily="Consolas" FontSize="18"/>
                                    <TextBlock Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" FontFamily="Consolas" FontSize="13"
                                               Foreground="{Binding ChangePct, Converter={StaticResource SignToBrush}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Pro only: everything in one 1D/1W/1M table -->
            <Border Style="{StaticResource ProCardStyle}" Visibility="{Binding IsPro, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="DETAILED BREAKDOWN" Style="{StaticResource CardTitleStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="INSTRUMENT" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="1D" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="2" Text="1W" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="3" Text="1M" Style="{StaticResource SectionLabelStyle}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DetailRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" FontFamily="Consolas"
                                               Foreground="{Binding ChangePct, Converter={StaticResource SignToBrush}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Change1wPct, StringFormat={}{0:+0.00;-0.00}%}" FontFamily="Consolas"
                                               Foreground="{Binding Change1wPct, Converter={StaticResource SignToBrush}}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Change1mPct, StringFormat={}{0:+0.00;-0.00}%}" FontFamily="Consolas"
                                               Foreground="{Binding Change1mPct, Converter={StaticResource SignToBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
