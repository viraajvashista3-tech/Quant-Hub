<UserControl x:Class="QuantHub.Desktop.Views.Pages.InsiderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveBrush}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Visibility="{Binding Data, Converter={StaticResource NotEmptyToVis}}">

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Data.Ticker}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding Data.Name}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeStyle}" Background="{Binding SentimentBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Data.NetSentiment}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Beginner: plain-English buy/sell sentiment, no raw ownership grid -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsBeginner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding BeginnerSummary}" TextWrapping="Wrap" FontSize="15"/>
            </Border>

            <UniformGrid Columns="2" Rows="1" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="OWNERSHIP" Style="{StaticResource CardTitleStyle}"/>
                        <UniformGrid Columns="2" Rows="1">
                            <StackPanel>
                                <TextBlock Text="Insider" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="{Binding Data.InsiderOwnership, StringFormat=P2}" FontFamily="Consolas" FontSize="20"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Institutional" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Text="{Binding Data.InstitutionalOwnership, StringFormat=P2}" FontFamily="Consolas" FontSize="20"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,16"
                        Visibility="{Binding Data.Purchases6m, Converter={StaticResource NotEmptyToVis}}">
                    <StackPanel>
                        <TextBlock Text="LAST 6 MONTHS" Style="{StaticResource CardTitleStyle}"/>
                        <UniformGrid Columns="2" Rows="1">
                            <StackPanel>
                                <TextBlock Text="Bought" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource PositiveBrush}">
                                    <Run Text="{Binding Data.Purchases6m.PurchaseShares, StringFormat=N0}"/>
                                    <Run Text=" sh"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                    <Run Text="{Binding Data.Purchases6m.PurchaseTrans, StringFormat=N0}"/>
                                    <Run Text=" transactions"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Sold" Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource DestructiveBrush}">
                                    <Run Text="{Binding Data.Purchases6m.SaleShares, StringFormat=N0}"/>
                                    <Run Text=" sh"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                    <Run Text="{Binding Data.Purchases6m.SaleTrans, StringFormat=N0}"/>
                                    <Run Text=" transactions"/>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Beginner: same real transactions, read as plain sentences instead of a grid -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsBeginner, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Recent insider activity" Style="{StaticResource FriendlyCardTitleStyle}"/>
                    <ItemsControl ItemsSource="{Binding NarrativeTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="6" Height="6" Margin="2,7,10,0" VerticalAlignment="Top" Fill="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Intermediate + Pro: full transaction table -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsIntermediatePlus, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="TRANSACTIONS" Style="{StaticResource CardTitleStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DATE" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="INSIDER" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="3" Text="SHARES" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Grid.Column="4" Text="VALUE" Style="{StaticResource SectionLabelStyle}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VisibleTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Date}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Insider}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Position}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                   Visibility="{Binding Position, Converter={StaticResource NotEmptyToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TransactionType}" FontWeight="SemiBold"
                                               Foreground="{Binding TransactionType, Converter={StaticResource TransactionTypeToBrush}}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Shares, StringFormat=N0}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Value, StringFormat=C0}" FontFamily="Consolas"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
