<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuantHub.Desktop.Views.Controls.ErrorCard"
             x:Name="Root"
             IsVisible="{Binding Message, ElementName=Root, Converter={StaticResource NotEmptyToVis}}">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DestructiveBrush}"
          BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="⚠" FontSize="18" Foreground="{DynamicResource DestructiveBrush}"
                 Margin="0,0,12,0" VerticalAlignment="Top"/>
      <TextBlock Text="{Binding Message, ElementName=Root}" Foreground="{DynamicResource DestructiveBrush}"
                 TextWrapping="Wrap" VerticalAlignment="Center"/>
    </StackPanel>
  </Border>
</UserControl>
