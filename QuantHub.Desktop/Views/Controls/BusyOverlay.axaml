<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuantHub.Desktop.Views.Controls.BusyOverlay"
             x:Name="Root"
             IsHitTestVisible="{Binding IsBusy, ElementName=Root}"
             IsVisible="{Binding IsBusy, ElementName=Root}">
  <Panel>
    <Border Background="{DynamicResource BackgroundBrush}" Opacity="0.6" CornerRadius="14"/>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="160">
      <ProgressBar IsIndeterminate="True" Height="4"/>
      <TextBlock Text="Loading…" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                 HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
  </Panel>
</UserControl>
