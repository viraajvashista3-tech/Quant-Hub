<Window x:Class="QuantHub.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Quant Terminal" Height="900" Width="1440" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="📈" FontSize="22" Margin="0,0,8,0"/>
                        <TextBlock Text="QUANT TERMINAL" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{DynamicResource BackgroundBrush}" BorderThickness="1" CornerRadius="10" Height="40">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TickerBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Opacity="0.6"/>
                            <TextBox x:Name="TickerBox" Grid.Column="1" Text="{Binding TickerInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="Bold"
                                     VerticalAlignment="Center" Padding="10,0,10,0"
                                     ToolTip="Type any ticker symbol - every page updates instantly."/>
                        </Grid>
                    </Border>

                    <ListBox Margin="0,16,0,0" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource PrimaryBrush}"
                                            Padding="6,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="0,6" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center">
                            <Run Text="VIEW MODE"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ViewModeLabel, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </TextBlock>
                    </Border>
                    <Button Content="⟳  Refresh Data" Margin="0,0,0,8" Command="{Binding RefreshCommand}"/>
                    <Button Content="⚙  Settings" Command="{Binding OpenSettingsCommand}"
                            ToolTip="Theme and difficulty mode (Beginner / Intermediate / Pro).">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18"
                    Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.15"/>
                </Border.Effect>
                <TextBlock Text="{Binding HeaderText}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}" Margin="24"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
